{
  "name": "teable-mcp",
  "version": "0.1.0",
  "description": "MCP server giving Claude access to a Teable workspace",
  "type": "module",
  "bin": {
    "teable-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:index": "npm run build && node scripts/build-endpoint-index.mjs",
    "setup": "npm run build --silent && node scripts/setup.mjs",
    "live-check": "npm run build --silent && node scripts/live-check.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
